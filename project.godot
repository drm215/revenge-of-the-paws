; Engine configuration file.

config_version=5

[application]

config/name="Revenge of the Paws"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.0941176, 0.0784314, 0.145098, 1)
boot_splash/image="res://art/splash.png"
boot_splash/use_filter=false

[autoload]

Cloud="*res://scripts/net/cloud.gd"
Team="*res://scripts/net/team.gd"
Chat="*res://scripts/net/chat.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
