static var _cache := {}


## The icon `id` as a texture (null if there's no such icon). Draw it with nearest filtering.
static func texture(id: String) -> Texture2D:
	if not ART.has(id):
		return null
	if not _cache.has(id):
		var image := Image.create(SIZE, SIZE, false, Image.FORMAT_RGBA8)
		var rows: Array = ART[id]
		for y in SIZE:
			var row: String = rows[y]
			for x in SIZE:
				var ch := row[x] if x < row.length() else "."
				image.set_pixel(x, y, PALETTE.get(ch, Color(0, 0, 0, 0)))
		_cache[id] = ImageTexture.create_from_image(image)
	return _cache[id]
